# Copier ce fichier en `.env` puis adapter les valeurs. Ne jamais committer `.env`.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=jurismind
POSTGRES_PASSWORD=jurismind
POSTGRES_DB=jurismind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Base « existante » simulée du cabinet
LEGACY_DB=legacy

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# Utilisateur PostgreSQL de l'application (soumis à l'isolation des données)
POSTGRES_APP_USER=jurismind_app
POSTGRES_APP_PASSWORD=jurismind_app
