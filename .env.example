# Copier ce fichier en `.env` puis adapter les valeurs. Ne jamais committer `.env`.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=jurismind
POSTGRES_PASSWORD=jurismind
POSTGRES_DB=jurismind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Base « existante » simulée du cabinet
LEGACY_DB=legacy

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# Utilisateur PostgreSQL de l'application (soumis à l'isolation des données)
POSTGRES_APP_USER=jurismind_app
POSTGRES_APP_PASSWORD=jurismind_app

# --- Modèles ---
LLM_FOURNISSEUR=ollama
MODELE_RAPIDE=qwen2.5:3b
MODELE_QUALITE=qwen2.5:latest
MODELE_EMBEDDINGS=bge-m3
# Nécessaire seulement si LLM_FOURNISSEUR=openai
OPENAI_API_KEY=

# --- API REST ---
# Clé de signature des jetons. À remplacer par une valeur tirée au hasard hors
# développement : changer cette clé invalide tous les jetons en circulation.
API_SECRET=jurismind-dev-secret-a-remplacer
# Durée de vie d'un jeton, en minutes (une journée de travail).
API_DUREE_JETON_MINUTES=480

# --- CRM du cabinet ---
CRM_BASE_URL=http://localhost:8100
CRM_API_KEY=crm-dev-key

# --- Documents du cabinet ---
DOCUMENTS_DIR=data/cabinet/documents
# Si tesseract.exe n'est pas dans le PATH :
# TESSERACT_EXE=C:/Program Files/Tesseract-OCR/tesseract.exe

# Dossier des langues de Tesseract (fra.traineddata)
TESSDATA_DIR=data/tessdata
